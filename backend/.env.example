# ---- Core ----
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# PostgreSQL in production; falls back to SQLite locally if left as-is.
DATABASE_URL=sqlite:///./vision64.db
# Example Postgres URL (Railway/Render style):
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/vision64

# ---- Stockfish engine ----
# Path to the Stockfish binary. `brew install stockfish` puts it on PATH.
STOCKFISH_PATH=stockfish
ENGINE_DEFAULT_DEPTH=18
ENGINE_MULTIPV=5
ENGINE_THREADS=2
ENGINE_HASH_MB=128
# How many warm Stockfish processes to keep alive (also caps concurrent analyses).
ENGINE_POOL_SIZE=3

# ---- Claude AI coach ----
ANTHROPIC_API_KEY=sk-ant-...
COACH_MODEL=claude-opus-5

# ---- Clerk auth ----
# Found in the Clerk dashboard. The issuer is https://<subdomain>.clerk.accounts.dev
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Set to true to bypass auth in local development (uses a dev user).
AUTH_DEV_BYPASS=true
